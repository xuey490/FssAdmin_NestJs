{
  "name": "nextjs-server",
  "version": "2.0.0",
  "description": "NestJS backend service for FssAdmin",
  "private": true,
  "license": "mit",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development bun run --watch src/main.ts",
    "dev:debug": "cross-env NODE_ENV=development bun run --inspect --watch src/main.ts",
    "dev:node": "cross-env NODE_ENV=development nest start --watch",
    "dev:prd": "cross-env NODE_ENV=production bun run --watch src/main.ts",
    "dev:prd:nest": "cross-env NODE_ENV=production nest start --watch",
    "start": "pnpm run dev",
    "start:test": "cross-env NODE_ENV=test bun run --watch src/main.ts",
    "start:test:nest": "cross-env NODE_ENV=test nest start --watch",
    "start:debug:nest": "nest start --debug --watch",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "rimraf dist tsconfig.tsbuildinfo",
    "build:nest": "cross-env NODE_ENV=production nest build",
    "build:prd": "cross-env NODE_ENV=production tsc -p tsconfig.build.json",
    "build:bun": "bun build src/main.ts --outdir dist --target bun --minify-whitespace --minify-syntax --external yamlparser --external mysql2 --external winston --external winston-daily-rotate-file --external class-transformer --external @nestjs/microservices --external @nestjs/platform-socket.io --external expo-sqlite --external better-sqlite3 --external sqlite3 --external pg --external pg-native --external pg-query-stream --external oracledb --external mongodb --external react-native-sqlite-storage --external @sap/hana-client --external hdb-pool --external sql.js --external svg-captcha --external pdf-parse --external pdfjs-dist",
    "bundle:bun": "bun build src/main.ts --outdir out --target bun --minify-whitespace --minify-syntax --external class-transformer --external yamlparser --external @nestjs/microservices --external @nestjs/platform-socket.io --external expo-sqlite --external better-sqlite3 --external sqlite3 --external pg --external pg-native --external pg-query-stream --external oracledb --external mongodb --external react-native-sqlite-storage --external @sap/hana-client --external hdb-pool --external sql.js --external svg-captcha --external pdf-parse --external pdfjs-dist && echo 打包完成。运行: bun out/main.js",
    "typecheck": "tsc --noEmit",
    "start:prod": "cross-env WEB_CONCURRENCY=4 NODE_ENV=production node dist/main.js",
    "start:bundle": "cross-env NODE_ENV=production bun out/main.js",
    "prod": "cross-env NODE_ENV=production pm2-runtime start ecosystem.config.cjs --interpreter bun",
    "prod:pm2": "cross-env NODE_ENV=production pm2 restart ecosystem.config.cjs --interpreter bun",
    "prod:stop": "pm2 stop ecosystem.config.cjs",
    "start:pm2": "cross-env NODE_ENV=production pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop nextjs-server",
    "restart:pm2": "pm2 restart nextjs-server",
    "logs:pm2": "pm2 logs nextjs-server",
    "init:auth": "node -r tsconfig-paths/register dist/auth/cli/init-auth.cli.js",
    "init:auth:dev": "pnpm run build && pnpm run init:auth",
    "verify:api": "node -r tsconfig-paths/register dist/api-verifier/cli/verify-apis.cli.js",
    "verify:api:dev": "pnpm run build && pnpm run verify:api",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:bun": "bun test",
    "typeorm": "typeorm-ts-node-commonjs -d ./src/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:revert",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "cleanlog": "rimraf logs"
  },
  "dependencies": {
    "@golevelup/nestjs-modules": "^2.1.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/neo4j": "^0.1.27",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.7.0",
    "@langchain/qdrant": "^1.0.3",
    "@napi-rs/canvas": "^1.0.13",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-ws": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.2.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cron": "^4.4.0",
    "cross-env-plugins": "^1.0.21",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "eventsource-parser": "^4.1.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fs-extra": "^11.4.1",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "iconv-lite": "^0.7.3",
    "ioredis": "^6.0.0",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "langchain": "^1.5.19",
    "lodash": "^4.18.1",
    "mammoth": "^1.13.0",
    "mime-types": "^3.0.2",
    "mysql2": "^3.24.6",
    "neo4j-driver": "^6.2.0",
    "openai": "^7.43.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "path-to-regexp": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "qdrant-client": "^0.0.1",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.2",
    "sensitive-word-tool": "^1.1.10",
    "svg-captcha": "^1.4.0",
    "typeorm": "^1.1.2",
    "undici": "^8.12.3",
    "useragent": "^2.3.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.22.0",
    "xss": "^1.0.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^7.2.1",
    "@types/useragent": "^2.3.4",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "request": "^2.88.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "yamlparser": "^0.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.entity.ts",
      "!**/dto/**",
      "!**/entities/**",
      "!**/*.module.ts",
      "!**/*.decorator.ts",
      "!**/*.constant.ts",
      "!**/index.ts",
      "!main.ts",
      "!**/api-verifier/**",
      "!**/template/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "coverageProvider": "v8",
    "coverageThreshold": {
      "**/configuration.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/ai-stream-registry.service.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/memory-monitor.service.ts": {
        "branches": 97,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/app-logger.service.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/memory-monitor.interceptor.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/readonly-mode.guard.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/llm-semaphore.service.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/export.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/file-log.sink.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/log-query.service.ts": {
        "branches": 94,
        "functions": 100,
        "lines": 97,
        "statements": 97
      },
      "**/chunk-merge.util.ts": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "**/disk-upload.util.ts": {
        "branches": 95,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "esbuild"
    ]
  }
}
